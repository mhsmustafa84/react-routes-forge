{
  "name": "react-routes-forge",
  "version": "1.0.2",
  "description": "Type-safe route definitions with automatic path builders for React apps",
  "type": "module",
  "author": {
    "name": "Mostafa Abdelhamid",
    "email": "mhsmustafa84@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhsmustafa84/react-routes-forge.git"
  },
  "homepage": "https://github.com/mhsmustafa84/react-routes-forge#readme",
  "bugs": "https://github.com/mhsmustafa84/react-routes-forge/issues",
  "keywords": [
    "react",
    "router",
    "routes",
    "typescript",
    "type-safe",
    "react-router",
    "path-builder"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --minify --sourcemap --clean",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "husky",
    "prepublishOnly": "bun run test && bun run build",
    "release": "standard-version"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-router-dom": ">=6"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "react-router-dom": "^6.0.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^26.1.1",
    "@types/bun": "^1.3.14",
    "husky": "^9.0.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
