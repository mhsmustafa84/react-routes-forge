{
  "name": "react-routes-forge",
  "version": "1.3.0",
  "description": "Type-safe route definitions, automatic path builders, query parameter handling, and active route matching for React applications with zero duplication.",
  "type": "module",
  "author": {
    "name": "Mostafa Abdelhamid",
    "email": "mhsmustafa84@gmail.com",
    "url": "https://github.com/mhsmustafa84"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhsmustafa84/react-routes-forge.git"
  },
  "bugs": {
    "url": "https://github.com/mhsmustafa84/react-routes-forge/issues"
  },
  "homepage": "https://mhsmustafa84.github.io/react-routes-forge",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "router",
    "routes",
    "routing",
    "typescript",
    "type-safe",
    "typesafe",
    "type-inference",
    "react-router",
    "react-router-dom",
    "path-builder",
    "route-builder",
    "typed-routes",
    "url-builder",
    "link-builder",
    "navigation",
    "query-params",
    "search-params",
    "url-params",
    "deep-linking",
    "spa",
    "frontend"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/hooks/index.ts --format esm,cjs --dts --minify --sourcemap --clean",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint . --ext .js,.cjs,.ts,.tsx",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "prepublishOnly": "bun run test && bun run build",
    "release": "standard-version",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-router-dom": ">=6",
    "react-router": ">=6"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "husky": "^9.0.0",
    "jsdom": "^29.1.1",
    "react-router-dom": "^6.0.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  }
}
